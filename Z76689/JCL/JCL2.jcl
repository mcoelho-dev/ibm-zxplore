//LNAMES    DD DISP=SHR,DSN=ZXP.PUBLIC.INPUT(LNAMES)
//COMBINED  DD DISP=SHR,DSN=&SYSUID..OUTPUT(NAMES)  <== FIX THIS ONE
//SYSOUT    DD SYSOUT=*,OUTLIM=15000
//CEEDUMP   DD DUMMY
//SYSUDUMP  DD DUMMY
//***************************************************/
